# ==============================================
# CHATBOT HADIS - ENVIRONMENT CONFIGURATION
# ==============================================
# Copy file ini menjadi .env dan sesuaikan dengan konfigurasi Anda

# ==============================================
# DATABASE CONFIGURATION
# ==============================================
# Format: postgresql+asyncpg://user:password@host:port/database
# Untuk Windows default: postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/chatbot_hadis
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/chatbot_hadis

# ==============================================
# OLLAMA CONFIGURATION
# ==============================================
# Model LLM yang akan digunakan (harus sudah di-pull dengan 'ollama pull mistral')
OLLAMA_MODEL=mistral

# Model untuk generate embeddings
# Rekomendasi: all-MiniLM-L6-v2 (cepat, ringan)
# Alternatif: sentence-transformers/paraphrase-multilingual-mpnet-base-v2 (lebih akurat untuk bahasa Indonesia)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ==============================================
# APPLICATION SETTINGS
# ==============================================
# Port untuk FastAPI backend
APP_PORT=8000

# Secret key untuk security (GANTI INI DI PRODUCTION!)
# Generate dengan: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-change-this-in-production-minimum-32-characters

# Directory untuk upload file PDF
UPLOAD_DIR=uploads

# ==============================================
# SEARCH & RETRIEVAL SETTINGS
# ==============================================
# Jumlah chunks yang akan diambil dari vector search
TOP_K_RESULTS=5

# ==============================================
# PERFORMANCE SETTINGS
# ==============================================
# Ukuran batch untuk processing chunks
BATCH_SIZE=50

# Ukuran batch untuk generate embeddings
EMBEDDING_BATCH_SIZE=32

# Ukuran connection pool database
DB_POOL_SIZE=10

# Cache TTL dalam menit
CACHE_TTL_MINUTES=30

# ==============================================
# NOTES
# ==============================================
# 1. File .env ini tidak akan di-commit ke Git (ada di .gitignore)
# 2. Untuk production, gunakan environment variables yang aman
# 3. Jangan commit file .env yang berisi credentials asli
# 4. Untuk Windows: pastikan PostgreSQL service running
# 5. Untuk Windows: pastikan Ollama running (ollama serve)
